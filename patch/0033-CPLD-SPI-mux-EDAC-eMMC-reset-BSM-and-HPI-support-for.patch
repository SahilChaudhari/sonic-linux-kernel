-	u32 mask;
-
-	val = elbasr_reset_shift(id);
-	if (val < 0)
-		return val;
-	mask = 1 << val;
-
-	return regmap_update_bits(elbar->regmap, ELBASR_CTRL0_REG, mask, 0);
